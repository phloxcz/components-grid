{
    "name": "phloxcz/components-grid",
    "description": "DataGrid UI component for Nette Framework",
    "type": "library",
    "license": "MIT",
    "keywords": ["nette", "datagrid", "grid", "table", "ui", "component"],
    "require": {
        "php": "^8.1",
        "nette/application": "^3.1 || ^4.0",
        "nette/database": "^3.1 || ^4.0",
        "nette/utils": "^3.2 || ^4.0"
    },
    "require-dev": {
        "nette/tester": "^2.4",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "Phlox\\Components\\Grid\\": "src/"
        }
    },
    "minimum-stability": "stable"
}
